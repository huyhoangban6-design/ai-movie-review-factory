# ---- Backend (backend/app/core/config.py) ----
# Mặc định local dùng SQLite tại backend/data/app.db. Trong Docker dùng PostgreSQL.
DATABASE_URL=postgresql+psycopg://app:apppassword@localhost:5432/movie_factory
# KHÔNG dùng secret bên dưới ở production. Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Origin của frontend dev (CORS). Nhiều origin ngăn bằng dấu phẩy.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Đường dẫn tới bản build tĩnh của frontend (Phase 1 chỉ để sẵn).
FRONTEND_DIST_PATH=frontend/dist

# ---- Redis (Phase 8: queue/worker; Phase 1 chưa bắt buộc) ----
REDIS_URL=redis://localhost:6379/0

# ---- Phase 2: providers (interface/adapters) ----
# Mặc định "offline" = provider giả, không gọi network. Khi có key thật:
# đổi tên provider + điền key (không bao giờ hard-code key vào code).
RESEARCH_PROVIDER=offline
OPPORTUNITY_PROVIDER=offline
ANGLE_PROVIDER=offline
# Bắt buộc khi dùng provider TMDB thật (Phase 2 optional):
TMDB_API_KEY=
# Web/search key dùng cho provider research thật (Phase 2 optional):
SEARCH_API_KEY=

# ---- Phase 3: script / voice / timeline providers ----
# Mặc định "offline" = giả lập có cấu trúc, không gọi network (đủ test pipeline).
SCRIPT_PROVIDER=offline
VOICE_PROVIDER=offline
TIMELINE_PROVIDER=offline
# Voice mặc định khi /voice/generate không truyền voice_profile_id.
DEFAULT_VOICE_PROVIDER=offline
DEFAULT_VOICE_MODEL=offline-vi-female
DEFAULT_VOICE_ID=offline-vi-female-1
# Bật khi có key provider TTS thật (VD: elevenlabs, google, azure):
# VOICE_API_KEY=

# ---- Phase 4: visual plan / asset / copyright providers ----
# Mặc định "offline" = planner determinisic, asset = CC0 placeholder, copyright = rule-based.
VISUAL_PROVIDER=offline
ASSET_PROVIDER=offline
COPYRIGHT_PROVIDER=offline
# asset_source_hint dùng khi asset provider là "ai_generated"; ở offline nó quyết định source tag.
ASSET_SOURCE_HINT=ai_generated